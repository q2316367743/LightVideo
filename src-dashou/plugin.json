{
  "$schema": "../node_modules/@dashou/cli/schema/plugin-1.json",
  "schemaVersion": 1,
  "id": "com.dashou.lightvideo",
  "name": "轻影 LightVideo",
  "version": "1.0.0",
  "description": "FFmpeg 视频工具箱：压缩、转格式、合并、剪辑、变速、加水印、烧录字幕、转 GIF、截图。",
  "author": { "name": "云中江树" },
  "homepage": "https://github.com/yzfly/lightvideo",
  "license": "MIT",
  "icon": "assets/icon.png",
  "core": "core.mjs",
  "activation": "onCommand",
  "resident": false,
  "windows": [
    {
      "label": "main",
      "title": "轻影 LightVideo",
      "url": "ui/index.html",
      "width": 1060,
      "height": 720,
      "minWidth": 860,
      "minHeight": 600,
      "center": true,
      "resizable": true,
      "backgroundColor": "#f6f8fb"
    }
  ],
  "commands": [
    {
      "id": "open",
      "title": "轻影 LightVideo",
      "description": "FFmpeg 视频工具箱：压缩 · 转格式 · 剪辑 · 字幕 · GIF",
      "keywords": [
        "lightvideo",
        "轻影",
        "视频压缩",
        "压缩视频",
        "视频转格式",
        "视频合并",
        "视频剪辑",
        "视频变速",
        "提取音频",
        "视频转gif",
        "视频截图",
        "加水印",
        "烧录字幕",
        "ffmpeg"
      ],
      "mode": "window",
      "window": "main"
    },
    {
      "id": "open-files",
      "title": "用轻影处理这些视频",
      "description": "把选中的视频加入轻影的处理队列",
      "match": {
        "type": "files",
        "fileType": "file",
        "extensions": [
          "mp4",
          "mov",
          "mkv",
          "avi",
          "flv",
          "wmv",
          "webm",
          "m4v",
          "ts",
          "mts",
          "m2ts",
          "3gp",
          "mpg",
          "mpeg",
          "rmvb"
        ]
      },
      "mode": "window",
      "window": "main"
    }
  ],
  "capabilities": [
    {
      "identifier": "main-ui",
      "targets": ["main"],
      "permissions": ["core:event:allow-listen", "ffmpeg:default"]
    },
    {
      "identifier": "core-base",
      "targets": ["core"],
      "permissions": ["dialog:allow-open", "log:allow-log"]
    }
  ],
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "dist"
  }
}
